# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local a Git.

# Base de datos. Vacío = PGlite local en ./.data/pglite (solo desarrollo).
# Producción: postgres://usuario:clave@host:5432/congreso_joven
DATABASE_URL=

# URL pública del sitio (SEO, enlaces para compartir)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sal para anonimizar IPs en el control antispam
IP_SALT=cambia-esto

# Cloudflare Turnstile (opcional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Almacenamiento de archivos: local | s3
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Notificaciones por correo (Resend u otro SMTP compatible), opcional
RESEND_API_KEY=
NOTIFY_EMAIL=
